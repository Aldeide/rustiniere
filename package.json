{
  "name": "rustiniere",
  "version": "1.0.0",
  "description": "Rustinière - Desktop Administration Suite for Rust Dedicated Servers",
  "main": "electron/main.cjs",
  "author": "Aldeide",
  "scripts": {
    "desktop": "electron .",
    "build:client": "npm --prefix client run build",
    "dist": "npm run build:client && electron-builder --win portable",
    "dist:installer": "npm run build:client && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.aldeide.rustiniere",
    "productName": "Rustiniere",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "win": {
      "target": ["portable", "nsis"]
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "keywords": ["rust", "rcon", "webrcon", "rustadmin", "server-management", "desktop"]
}
